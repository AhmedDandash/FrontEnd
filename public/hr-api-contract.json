          "response": { "$ref": "#/schemas/VacationRequest" },
          "errors": {
            "400": "Validation failure (days out of range, dates invalid)",
            "409": "Overlapping vacation request exists"
          }
        },
        {
          "id": "approve-vacation",
          "method": "POST",
          "url": "/api/HR/VacationRequest/Approve/{id}",
          "pathParams": { "id": "integer" },
          "request_body": {},
          "response": { "$ref": "#/schemas/VacationRequest" }
        },
        {
          "id": "reject-vacation",
          "method": "POST",
          "url": "/api/HR/VacationRequest/Reject/{id}",
          "pathParams": { "id": "integer" },
          "request_body": { "reason": "string" },
          "response": { "$ref": "#/schemas/VacationRequest" }
        }
      ]
    },
