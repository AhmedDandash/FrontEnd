    "vacationRequest": {
      "description": "Vacation leave requests",
      "statusFlow": ["Pending(3) → Approved(1) | Rejected(2)"],
      "endpoints": [
        {
          "id": "get-all-vacation",
          "method": "GET",
          "url": "/api/HR/VacationRequest/GetAll",
          "response": { "type": "array", "items": { "$ref": "#/schemas/VacationRequest" } }
        },
        {
          "id": "get-vacation-by-id",
