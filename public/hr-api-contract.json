{
  "$schema": "https://json-schema.org/draft-07/schema",
  "version": "1.0.0",
  "title": "HR Module – Backend API Contract",
  "description": "Production-ready API contract for the HR module. Frontend models are aligned to this contract exactly. All endpoints follow the pattern /api/HR/{Domain}/{Action}.",
  "generated": "2026-04-10",
  "authentication": {
    "type": "Bearer JWT",
    "header": "Authorization: Bearer <token>",
    "claims": {
      "nameid": "User numeric ID (maps to employee lookup)",
      "unique_name": "Display name",
      "role": "User role string"
    },
    "notes": "The GET /api/HR/Employee/GetCurrent endpoint resolves the logged-in user to their HR employee record using the JWT nameid claim."
  },
  "commonResponses": {
    "200": "Success",
    "400": { "message": "string", "errors": { "field": ["string"] } },
    "401": { "message": "Unauthorized" },
    "403": { "message": "Forbidden" },
    "404": { "message": "Not found" },
    "500": { "message": "Internal server error" }
  },
  "pagination": {
    "queryParams": {
      "page": "integer (1-based, default 1)",
      "pageSize": "integer (default 20)",
      "sortBy": "string (field name)",
      "sortDir": "asc | desc"
    },
    "responseWrapper": {
      "data": "array",
      "total": "integer",
      "page": "integer",
      "pageSize": "integer"
    }
  },
  "enums": {
    "HRRequestResult": {
      "0": "Unspecified",
      "1": "Approved",
      "2": "Rejected",
      "3": "Pending"
    },
    "HRProcessState": {
      "1": "Vacation",
      "2": "Permission",
      "4": "Custody",
      "5": "JobModification",
      "6": "Resignation",
      "7": "Entitlements",
      "8": "Loans",
      "9": "Other"
    },
    "HRPermissionType": {
      "1": "ComeLate",
      "2": "PartTime",
      "3": "OutEarly"
    },
    "HRPermissionNature": {
      "1": "Official",
      "2": "Personal"
    },
    "HRVacationType": {
      "81": "AnnualLeave",
      "72": "SickLeave",
      "77": "UnpaidLeave",
      "78": "MaternityLeave",
      "79": "CasualLeave",
      "84": "HajjLeave",
      "80": "MarriageLeave",
      "73": "BereavementLeave",
      "82": "EmergencyLeave",
      "83": "SportsLeave"
    },
    "HREntitlementType": {
      "1": "HousingAllowance",
      "2": "TransportationAllowance",
      "3": "PhoneAllowance",
      "4": "MedicalAllowance",
      "5": "Other"
    },
    "AttendanceStatus": {
      "0": "Unknown",
      "1": "Present",
      "2": "Absent",
      "3": "Late"
    },
    "HRComplaintStatus": {
      "1": "Open",
      "2": "Resolved",
      "3": "Closed"
    },
    "CommissionType": {
      "1": "Bonus",
      "2": "SalesCommission",
      "3": "Incentive",
      "4": "Other"
    }
  },
  "domains": {
    "employees": {
      "description": "HR employee records and lookups",
      "endpoints": [
        {
          "id": "get-all-employees",
          "method": "GET",
          "url": "/api/HR/Employee/GetAll",
          "description": "List all employees with optional filters",
          "queryParams": {
            "nameAr": "string?",
            "loginName": "string?",
            "email": "string?"
          },
          "response": {
            "type": "array",
            "items": {
              "id": "string (GUID)",
              "employeeNumber": "string",
              "nameAr": "string",
              "nameEn": "string",
              "email": "string?",
              "loginName": "string?",
              "jobId": "integer",
              "jobName": "string",
              "departmentId": "integer",
              "departmentName": "string",
              "nationalityId": "integer",
              "nationalityName": "string",
              "idNumber": "string",
              "mobileNumber": "string?",
              "hiringDate": "string (ISO date)?",
              "isActive": "boolean"
            }
          }
        },
        {
          "id": "get-employee-by-id",
          "method": "GET",
          "url": "/api/HR/Employee/GetById/{id}",
          "pathParams": { "id": "string (GUID)" },
          "response": { "$ref": "#/domains/employees/endpoints/0/response/items" }
        },
        {
          "id": "get-current-employee",
          "method": "GET",
          "url": "/api/HR/Employee/GetCurrent",
          "description": "Returns the HR employee record for the authenticated user (resolved via JWT nameid)",
          "response": {
            "id": "string (GUID)",
            "employeeNumber": "string",
            "nameAr": "string",
            "nameEn": "string",
            "jobName": "string",
            "departmentId": "integer",
            "departmentName": "string",
            "nationalityName": "string",
            "idNumber": "string",
            "mobileNumber": "string?",
            "hiringDate": "string?",
            "basicSalary": "number?",
            "housingAllowance": "number?",
            "mobilityAllowance": "number?",
            "otherAllowances": "number?",
            "totalSalary": "number?"
          }
        },
        {
          "id": "search-employees",
          "method": "GET",
          "url": "/api/HR/Employee/Search",
          "queryParams": { "q": "string (min 2 chars)" },
          "response": { "type": "array", "items": { "$ref": "#/domains/employees/endpoints/2/response" } }
        }
      ]
    },
