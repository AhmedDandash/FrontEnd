        },
        {
          "id": "create-vacation",
          "method": "POST",
          "url": "/api/HR/VacationRequest/Create",
          "request_body": {
            "createdTo": "string (GUID, employee ID)",
            "vacationType": "integer (HRVacationType enum)",
            "vacationDays": "integer (1–365)",
